# Production origin used for canonical URLs, Open Graph / Twitter card URLs,
# the XML sitemap and robots.txt. Do not include a trailing slash or the base
# path here.
#
# Copy this file to `.env` and adjust both values for the deployment target.
#
# GitHub Pages project site (the default production build):
SITE_URL=https://legendcoder01.github.io
BASE_PATH=/keysprint

# Domain root instead (user site, custom domain or Render):
# SITE_URL=https://keysprint.example
# BASE_PATH=/
