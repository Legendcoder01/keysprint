# Production origin used for canonical URLs, Open Graph / Twitter card URLs,
# the XML sitemap and robots.txt.
#
# Copy this file to `.env` and set your real origin before building.
# On Render, add the same variable under "Environment Variables" for the service.
#
# Default when unset: https://keysprint.onrender.com
SITE_URL=https://keysprint.onrender.com
