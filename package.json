{
  "name": "keysprint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "keysprint — a free online typing test, typing speed measurement, and touch-typing lesson platform.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "node scripts/generate-og.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
