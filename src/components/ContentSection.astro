---
interface Props {
	/** Section heading. Omit for a section without a heading. */
	title?: string;
	/** Heading level, so sections nest correctly under the page heading. */
	level?: 2 | 3;
	/** Anchor id, so the section can be linked to directly. */
	id?: string;
	/** Short paragraph directly under the heading. */
	lead?: string;
	/** Constrain the text column. */
	narrow?: boolean;
}

const { title, level = 2, id, lead, narrow = true } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6" id={id}>
	<div class={narrow ? 'max-w-3xl' : ''}>
		{
			title && (
				<Heading class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</Heading>
			)
		}
		{lead && <p class="mt-3 text-base leading-relaxed text-ink-muted">{lead}</p>}
		<div class="mt-5 space-y-4 text-[15px] leading-relaxed text-ink-muted">
			<slot />
		</div>
	</div>
</section>
